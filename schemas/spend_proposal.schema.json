{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zlint.local/schemas/spend_proposal.schema.json",
  "title": "SpendProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["destination", "amount_zatoshis", "proposed_at_ms"],
  "properties": {
    "destination": {
      "type": "string",
      "minLength": 1,
      "description": "Unified address. Milestone 1 checks non-empty only. Allowlist matching is Milestone 2."
    },
    "amount_zatoshis": {
      "type": "integer",
      "minimum": 1
    },
    "proposed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time in milliseconds."
    },
    "memo": {
      "type": "string"
    },
    "input_zatoshis": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional. Used by the Milestone 3 change check."
    },
    "change_zatoshis": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional. Used by the Milestone 3 change check."
    }
  }
}
